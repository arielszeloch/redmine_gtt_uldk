<% cfs = IssueCustomField.sorted.to_a %>
<% resolved = RedmineGttUldk::Settings.fields %>
<% { commune: :label_gtt_uldk_commune_field, precinct: :label_gtt_uldk_precinct_field,
     parcel: :label_gtt_uldk_parcel_field }.each do |kind, label| %>
  <p>
    <%= content_tag :label, l(label) %>
    <%= select_tag "settings[#{kind}_field_id]",
          options_for_select([[l(:label_gtt_uldk_auto_field, name: resolved[kind]&.name || '-'), '']] +
                             cfs.map { |cf| [cf.name, cf.id.to_s] },
                             @settings["#{kind}_field_id"].to_s) %>
  </p>
<% end %>
<em class="info"><%= l(:text_gtt_uldk_fields_info) %></em>

<p>
  <%= content_tag :label, l(:label_gtt_uldk_unit_map) %>
  <%= text_area_tag 'settings[unit_map]', @settings['unit_map'], rows: 5, cols: 60,
                    placeholder: "Bydgoszcz, M. Bydgoszcz = 046101_1" %>
</p>
<em class="info"><%= l(:text_gtt_uldk_unit_map_info) %></em>

<p>
  <%= content_tag :label, l(:label_gtt_uldk_auto_geocode) %>
  <%= hidden_field_tag 'settings[auto_geocode]', '0' %>
  <%= check_box_tag 'settings[auto_geocode]', '1', @settings['auto_geocode'].to_s == '1' %>
</p>
<em class="info"><%= l(:text_gtt_uldk_auto_geocode_info) %></em>

<p>
  <%= content_tag :label, l(:label_gtt_uldk_max_parcels) %>
  <%= number_field_tag 'settings[max_parcels]', @settings['max_parcels'], min: 1, max: 200 %>
</p>
